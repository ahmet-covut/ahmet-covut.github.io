---
import SectionHeader from './SectionHeader.astro';
import { about, personal, type Lang } from '../data/profile';
import { asset, localePath, localize, pick, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="bg-slate-50 dark:bg-slate-900/40">
  <div class="section">
    <SectionHeader title={t('about.title')} />
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[auto_1fr] lg:gap-12">
      <div class="reveal mx-auto lg:pt-1">
        <div class="relative grid size-40 place-items-center overflow-hidden rounded-2xl bg-slate-200 text-5xl font-extrabold text-slate-500 shadow-lg ring-1 ring-slate-900/5 lg:size-50 lg:rounded-3xl lg:text-6xl dark:bg-slate-800 dark:text-slate-400 dark:ring-white/10">
          {personal.initials}
          {
            personal.avatar && (
              <img
                src={asset(personal.avatar)}
                alt={personal.name}
                width="200"
                height="200"
                class="absolute inset-0 h-full w-full object-cover"
                loading="lazy"
                onerror="this.remove()"
              />
            )
          }
        </div>
      </div>
      <div class="reveal space-y-5">
        {
          pick(about.paragraphs, lang).map((p) => (
            <p class="text-lg leading-relaxed text-slate-600 dark:text-slate-300">{p}</p>
          ))
        }
        <dl class="grid grid-cols-1 gap-4 pt-4 sm:grid-cols-3">
          {
            about.highlights.map((h) => (
              <div class="card text-center">
                <dt class="sr-only">{pick(h.label, lang)}</dt>
                <dd class="text-3xl font-extrabold text-brand-600 dark:text-brand-400">{localize(h.value, lang)}</dd>
                <dd class="mt-1 text-sm text-slate-500 dark:text-slate-400">{pick(h.label, lang)}</dd>
              </div>
            ))
          }
        </dl>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          <span class="font-semibold text-slate-700 dark:text-slate-300">{t('about.languages')}:</span>{' '}
          {pick(about.languages, lang)}
        </p>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          {t('about.freelanceNote')}{' '}
          <a href={localePath(lang, 'freelance')} class="font-semibold text-brand-600 hover:underline dark:text-brand-400">
            {t('about.freelanceLink')}
          </a>
        </p>
      </div>
    </div>
  </div>
</section>
