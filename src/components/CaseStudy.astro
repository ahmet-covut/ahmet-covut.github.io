---
import Icon from './Icon.astro';
import PhoneMockup from './PhoneMockup.astro';
import StoreLinks from './StoreLinks.astro';
import { projects, type Lang, type Project } from '../data/profile';
import { asset, localePath, localize, pick, useTranslations } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang);

const index = projects.findIndex((p) => p.slug === project.slug);
const next = projects[(index + 1) % projects.length];

const landscape = project.orientation === 'landscape';
const shots = project.screenshots.length > 0 ? project.screenshots.slice(0, 3) : [undefined, undefined, undefined];
---

<article>
  <header class="relative overflow-hidden" style={`background: linear-gradient(160deg, ${project.color}26, transparent 70%)`}>
    <div class="mx-auto max-w-6xl px-5 pt-10 pb-16 sm:px-8">
      <a
        href={`${home}#projects`}
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-600 hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400"
      >
        <Icon name="arrowLeft" class="h-4 w-4" />
        {t('case.back')}
      </a>
      <div class="mt-8 flex flex-wrap items-center gap-2 text-xs font-semibold">
        <span class="rounded-full px-2.5 py-1 text-white" style={`background:${project.color}`}>
          {pick(project.category, lang)}
        </span>
        {project.platforms.map((p) => <span class="badge">{p}</span>)}
      </div>
      <div class="mt-4 flex items-center gap-4">
        {
          project.icon && (
            <img
              src={asset(project.icon)}
              alt=""
              width="64"
              height="64"
              class="h-14 w-14 shrink-0 rounded-2xl shadow-md ring-1 ring-slate-900/5 sm:h-16 sm:w-16"
            />
          )
        }
        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl dark:text-white">
          {project.name}
        </h1>
      </div>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">
        {pick(project.summary, lang)}
      </p>
      <div class="mt-6">
        <StoreLinks links={project.links} lang={lang} />
      </div>

      {
        landscape ? (
          <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-3 lg:gap-8">
            {shots.map((shot, i) => (
              <PhoneMockup
                name={project.name}
                subtitle={pick(project.category, lang)}
                color={project.color}
                screenshot={shot}
                orientation="landscape"
                eager={i === 0}
                class={i === 0 ? 'w-full' : 'hidden w-full sm:block'}
              />
            ))}
          </div>
        ) : (
          <div class="mt-14 flex items-end justify-center gap-4 sm:gap-8">
            {shots.map((shot, i) => (
              <PhoneMockup
                name={project.name}
                subtitle={pick(project.category, lang)}
                color={project.color}
                screenshot={shot}
                eager={i === 1}
                class={i === 1 ? 'w-40 sm:w-56' : 'hidden w-32 sm:block sm:w-44'}
              />
            ))}
          </div>
        )
      }
    </div>
  </header>

  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-5 py-16 sm:px-8 lg:grid-cols-[1fr_300px]">
    <div class="space-y-12">
      <section class="reveal">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">{t('case.contribution')}</h2>
        <ul class="mt-5 list-disc space-y-3 pl-5 text-lg leading-relaxed text-slate-600 marker:text-slate-400 dark:text-slate-300">
          {pick(project.contribution, lang).map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="reveal">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">{t('case.results')}</h2>
        <dl class="mt-5 grid gap-4 sm:grid-cols-3">
          {
            project.metrics.map((m) => (
              <div class="flex flex-col-reverse rounded-xl border border-slate-200 p-4 dark:border-slate-800">
                <dt class="text-sm text-slate-500 dark:text-slate-400">{pick(m.label, lang)}</dt>
                <dd class="text-3xl font-extrabold" style={`color:${project.color}`}>{localize(m.value, lang)}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>

    <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
      <div class="card">
        <dl class="space-y-5 text-sm">
          <div>
            <dt class="font-semibold text-slate-900 dark:text-white">{t('case.platforms')}</dt>
            <dd class="mt-1 text-slate-600 dark:text-slate-400">{project.platforms.join(', ')}</dd>
          </div>
          {
            project.year && (
              <div>
                <dt class="font-semibold text-slate-900 dark:text-white">{t('case.year')}</dt>
                <dd class="mt-1 text-slate-600 dark:text-slate-400">{project.year}</dd>
              </div>
            )
          }
          <div>
            <dt class="font-semibold text-slate-900 dark:text-white">{t('case.tech')}</dt>
            <dd class="mt-2 flex flex-wrap gap-1.5">
              {project.tech.map((tech) => <span class="badge">{tech}</span>)}
            </dd>
          </div>
        </dl>
      </div>
      <div class="card">
        <p class="font-semibold text-slate-900 dark:text-white">{t('case.cta')}</p>
        <a href={`${localePath(lang, 'freelance')}#contact`} class="btn-primary mt-4 w-full">
          {t('case.ctaButton')}
        </a>
      </div>
    </aside>
  </div>

  {
    next && next.slug !== project.slug && (
      <div class="border-t border-slate-200 dark:border-slate-800">
        <a
          href={localePath(lang, `projects/${next.slug}`)}
          class="group mx-auto flex max-w-6xl items-center justify-between px-5 py-10 sm:px-8"
        >
          <span>
            <span class="block text-sm text-slate-500 dark:text-slate-400">{t('case.next')}</span>
            <span class="text-2xl font-bold text-slate-900 group-hover:text-brand-600 dark:text-white dark:group-hover:text-brand-400">
              {next.name}
            </span>
          </span>
          <Icon name="arrowRight" class="h-6 w-6 text-slate-400 transition group-hover:translate-x-1 group-hover:text-brand-600" />
        </a>
      </div>
    )
  }
</article>
