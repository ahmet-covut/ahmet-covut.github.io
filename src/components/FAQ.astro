---
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { faq, type Lang } from '../data/profile';
import { pick, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: pick(item.q, lang),
    acceptedAnswer: { '@type': 'Answer', text: pick(item.a, lang) },
  })),
};
---

<section id="faq" class="section">
  <SectionHeader title={t('faq.title')} center />
  <div class="mx-auto max-w-3xl space-y-3">
    {
      faq.map((item, i) => (
        <details
          class="card reveal group !p-0 open:border-brand-300 dark:open:border-brand-700"
          open={i === 0}
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-semibold text-slate-900 dark:text-white [&::-webkit-details-marker]:hidden">
            {pick(item.q, lang)}
            <Icon name="chevronDown" class="h-5 w-5 shrink-0 text-slate-400 transition group-open:rotate-180" />
          </summary>
          <p class="px-5 pb-5 leading-relaxed text-slate-600 dark:text-slate-300">{pick(item.a, lang)}</p>
        </details>
      ))
    }
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>
