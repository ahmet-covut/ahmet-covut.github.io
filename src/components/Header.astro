---
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { personal, type Lang } from '../data/profile';
import { localePath, useTranslations, type UiKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang);

const links: { href: string; key: UiKey }[] = [
  { href: `${home}#about`, key: 'nav.about' },
  { href: `${home}#projects`, key: 'nav.projects' },
  { href: `${home}#experience`, key: 'nav.experience' },
  { href: localePath(lang, 'freelance'), key: 'nav.freelance' },
];
const contactHref = path === 'freelance' ? '#contact' : `${home}#contact`;
---

<header
  class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/80 backdrop-blur-lg dark:border-slate-800/70 dark:bg-slate-950/80"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href={home} class="text-lg font-bold tracking-tight text-slate-900 dark:text-white">
      {personal.name}
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.key === 'nav.freelance' && path === 'freelance' ? 'page' : undefined}
              class="rounded-full px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 aria-[current=page]:text-brand-600 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white dark:aria-[current=page]:text-brand-400"
            >
              {t(link.key)}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <LanguageSwitcher lang={lang} path={path} />
      <ThemeToggle label={t('theme.toggle')} />
      <a href={contactHref} class="btn-primary hidden !px-4 !py-2 sm:inline-flex">
        {t('nav.contact')}
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="grid h-10 w-10 place-items-center rounded-full text-slate-700 hover:bg-slate-100 lg:hidden dark:text-slate-300 dark:hover:bg-slate-800"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-slate-200 lg:hidden dark:border-slate-800">
    <ul class="mx-auto flex max-w-6xl flex-col px-5 py-3 sm:px-8">
      {
        [...links, { href: contactHref, key: 'nav.contact' as UiKey }].map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-lg px-3 py-3 font-medium text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"
            >
              {t(link.key)}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  }
</script>
