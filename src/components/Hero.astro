---
import Icon from './Icon.astro';
import PhoneMockup from './PhoneMockup.astro';
import SocialLinks from './SocialLinks.astro';
import { personal, projects, type Lang } from '../data/profile';
import { asset, pick, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const back = projects.find((p) => p.orientation === 'landscape') ?? projects[1];
const front = projects.find((p) => p.orientation !== 'landscape') ?? projects[0];
---

<section>
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-5 pt-16 pb-20 sm:px-8 lg:grid-cols-[1.2fr_1fr] lg:pt-24">
    <div>
      {
        personal.availableForWork && (
          <p class="inline-flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400">
            <span class="h-2 w-2 rounded-full bg-emerald-500" />
            {t('hero.status')}
          </p>
        )
      }

      <p class="mt-8 text-lg font-medium text-slate-500 dark:text-slate-400">{t('hero.hello')}</p>
      <h1 class="mt-1 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-6xl dark:text-white">
        {personal.name}
      </h1>
      <p class="mt-3 text-2xl font-bold text-brand-600 sm:text-3xl dark:text-brand-400">
        {pick(personal.title, lang)}
      </p>
      <p class="mt-2 font-mono text-sm text-slate-500 dark:text-slate-400">{personal.stackLine}</p>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">
        {pick(personal.tagline, lang)}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={asset(pick(personal.cv, lang))} class="btn-primary" download>
          <Icon name="download" />
          {t('hero.cv')}
        </a>
        <a href="#contact" class="btn-secondary">
          {t('hero.contact')}
          <Icon name="arrowRight" />
        </a>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-4 text-sm text-slate-500 dark:text-slate-400">
        <span class="inline-flex items-center gap-1.5">
          <Icon name="mapPin" class="h-4 w-4" />
          {pick(personal.location, lang)}
        </span>
        <SocialLinks class="-ml-2" />
      </div>
    </div>

    <div class="relative mx-auto h-[400px] w-full max-w-md sm:h-[460px]">
      {
        back && (
          <div class="absolute top-6 left-0 w-[88%] -rotate-3">
            <PhoneMockup
              name={back.name}
              subtitle={pick(back.category, lang)}
              color={back.color}
              screenshot={back.screenshots[0]}
              orientation={back.orientation}
              eager
              class="w-full"
            />
          </div>
        )
      }
      {
        front && (
          <div class="absolute right-2 bottom-2 w-36 rotate-3 sm:w-44">
            <PhoneMockup
              name={front.name}
              subtitle={pick(front.category, lang)}
              color={front.color}
              screenshot={front.screenshots[0]}
              orientation={front.orientation}
              eager
              class="w-full"
            />
          </div>
        )
      }
    </div>
  </div>
</section>
