---
import { asset } from '../i18n/ui';

interface Props {
  name: string;
  color: string;
  subtitle?: string;
  screenshot?: string;
  orientation?: 'portrait' | 'landscape';
  eager?: boolean;
  class?: string;
}

const {
  name,
  color,
  subtitle = '',
  screenshot,
  orientation = 'portrait',
  eager = false,
  class: className = 'w-56',
} = Astro.props;
const landscape = orientation === 'landscape';
---

<div
  class:list={[
    'relative shrink-0 border-slate-900 bg-slate-900 shadow-2xl shadow-slate-900/30 dark:border-slate-700',
    landscape ? 'aspect-[16/9] rounded-[1.6rem] border-[8px]' : 'aspect-[9/19] rounded-[2.6rem] border-[10px]',
    className,
  ]}
>
  {
    landscape ? (
      <div class="absolute top-1/2 left-1.5 z-10 h-14 w-3 -translate-y-1/2 rounded-full bg-slate-900 dark:bg-slate-700" />
    ) : (
      <div class="absolute top-2 left-1/2 z-10 h-5 w-20 -translate-x-1/2 rounded-full bg-slate-900 dark:bg-slate-700" />
    )
  }
  <div
    class:list={[
      'h-full w-full overflow-hidden bg-white dark:bg-slate-900',
      landscape ? 'rounded-[1.1rem]' : 'rounded-[1.9rem]',
    ]}
  >
    {
      screenshot ? (
        <img
          src={asset(screenshot)}
          alt={name}
          class="h-full w-full object-cover object-top"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <div class="flex h-full flex-col text-left" aria-hidden="true">
          <div class="px-4 pt-8 pb-5 text-white" style={`background: linear-gradient(160deg, ${color}, ${color}cc)`}>
            <p class="text-[0.6rem] tracking-wider uppercase opacity-80">{subtitle}</p>
            <p class="mt-1 text-lg leading-tight font-bold">{name}</p>
            <div class="mt-4 rounded-xl bg-white/20 p-3 backdrop-blur">
              <div class="h-2 w-16 rounded bg-white/70" />
              <div class="mt-2 h-6 w-24 rounded bg-white" />
              <div class="mt-3 h-1.5 w-full rounded-full bg-white/30">
                <div class="h-1.5 w-2/3 rounded-full bg-white" />
              </div>
            </div>
          </div>
          <div class="flex-1 space-y-2.5 bg-slate-50 p-3 dark:bg-slate-800">
            {[0.9, 0.7, 0.8, 0.6].map((w) => (
              <div class="flex items-center gap-2.5 rounded-xl bg-white p-2.5 shadow-sm dark:bg-slate-900">
                <div class="h-8 w-8 shrink-0 rounded-lg" style={`background:${color}33`} />
                <div class="flex-1 space-y-1.5">
                  <div class="h-2 rounded bg-slate-300 dark:bg-slate-600" style={`width:${w * 100}%`} />
                  <div class="h-1.5 w-1/2 rounded bg-slate-200 dark:bg-slate-700" />
                </div>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </div>
</div>
