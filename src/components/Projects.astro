---
import Icon from './Icon.astro';
import PhoneMockup from './PhoneMockup.astro';
import SectionHeader from './SectionHeader.astro';
import StoreLinks from './StoreLinks.astro';
import { otherApps, projects, type Lang } from '../data/profile';
import { asset, localePath, localize, pick, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="projects" class="section">
  <SectionHeader title={t('projects.title')} subtitle={t('projects.subtitle')} />
  <div class="space-y-10">
    {
      projects.map((project, i) => (
        <article class="card reveal grid items-center gap-8 overflow-hidden !p-0 md:grid-cols-2">
          <div
            class:list={[
              'flex h-full items-center justify-center px-6',
              project.orientation === 'landscape' ? 'py-10' : 'pt-10 md:py-10',
              i % 2 === 1 && 'md:order-2',
            ]}
            style={`background: linear-gradient(135deg, ${project.color}22, ${project.color}08)`}
          >
            <PhoneMockup
              name={project.name}
              subtitle={pick(project.category, lang)}
              color={project.color}
              screenshot={project.screenshots[0]}
              orientation={project.orientation}
              class={project.orientation === 'landscape' ? 'w-full max-w-md' : 'w-48 translate-y-6 md:translate-y-0'}
            />
          </div>
          <div class="p-6 md:p-10">
            <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
              <span class="rounded-full px-2.5 py-1 text-white" style={`background:${project.color}`}>
                {pick(project.category, lang)}
              </span>
              {project.platforms.map((p) => (
                <span class="badge">{p}</span>
              ))}
              {project.year && <span class="text-slate-400">{project.year}</span>}
            </div>
            <div class="mt-4 flex items-center gap-3">
              {project.icon && (
                <img
                  src={asset(project.icon)}
                  alt=""
                  width="48"
                  height="48"
                  loading="lazy"
                  class="h-12 w-12 shrink-0 rounded-xl shadow-sm ring-1 ring-slate-900/5"
                />
              )}
              <h3 class="text-2xl font-bold text-slate-900 dark:text-white">{project.name}</h3>
            </div>
            <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-300">{pick(project.summary, lang)}</p>

            <dl class="mt-6 grid grid-cols-3 gap-3">
              {project.metrics.map((m) => (
                <div class="flex flex-col-reverse rounded-xl bg-slate-50 p-3 dark:bg-slate-800/60">
                  <dt class="text-xs text-slate-500 dark:text-slate-400">{pick(m.label, lang)}</dt>
                  <dd class="text-lg font-bold text-slate-900 dark:text-white">{localize(m.value, lang)}</dd>
                </div>
              ))}
            </dl>

            <ul class="mt-6 flex flex-wrap gap-1.5">
              {project.tech.map((tech) => (
                <li class="rounded-md border border-slate-200 px-2 py-0.5 font-mono text-xs text-slate-600 dark:border-slate-700 dark:text-slate-400">
                  {tech}
                </li>
              ))}
            </ul>

            <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
              <StoreLinks links={project.links} lang={lang} />
              <a
                href={localePath(lang, `projects/${project.slug}`)}
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:gap-2.5 transition-all dark:text-brand-400"
              >
                {t('projects.caseStudy')}
                <Icon name="arrowRight" class="h-4 w-4" />
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
  {
    otherApps.length > 0 && (
      <div class="card reveal mt-10">
        <h3 class="font-bold text-slate-900 dark:text-white">
          {t('projects.otherApps')} <span class="text-brand-600 dark:text-brand-400">({otherApps.length})</span>
        </h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {otherApps.map((app) => (
            <li class="badge">{app}</li>
          ))}
        </ul>
      </div>
    )
  }
</section>
