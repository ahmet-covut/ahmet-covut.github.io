---
interface Props {
  title: string;
  subtitle?: string;
  center?: boolean;
}

const { title, subtitle, center = false } = Astro.props;
---

<div class:list={['reveal mb-12', center && 'text-center']}>
  <h2 class="section-title">{title}</h2>
  {subtitle && <p class:list={['section-subtitle', center && 'mx-auto']}>{subtitle}</p>}
</div>
