---
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { services, type Lang } from '../data/profile';
import { pick, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="services" class="section">
  <SectionHeader title={t('services.title')} subtitle={t('services.subtitle')} />
  <div class="grid gap-6 md:grid-cols-2">
    {
      services.map((service) => (
        <div class="card reveal flex flex-col hover:-translate-y-1 hover:border-brand-300 hover:shadow-lg dark:hover:border-brand-700">
          <div class="flex items-start justify-between gap-4">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-brand-50 text-brand-600 dark:bg-brand-500/10 dark:text-brand-400">
              <Icon name={service.icon} class="h-6 w-6" />
            </span>
            <div class="text-right">
              <p class="font-bold text-slate-900 dark:text-white">{pick(service.priceFrom, lang)}</p>
              <p class="text-xs text-slate-500 dark:text-slate-400">
                {t('services.duration')}: {pick(service.duration, lang)}
              </p>
            </div>
          </div>
          <h3 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">{pick(service.title, lang)}</h3>
          <p class="mt-2 text-slate-600 dark:text-slate-300">{pick(service.description, lang)}</p>
          <ul class="mt-5 flex-1 space-y-2">
            {pick(service.features, lang).map((f) => (
              <li class="flex gap-2 text-sm text-slate-600 dark:text-slate-300">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" />
                {f}
              </li>
            ))}
          </ul>
          <a
            href="#contact"
            data-service={pick(service.title, lang)}
            class="mt-6 inline-flex items-center gap-1.5 self-start text-sm font-semibold text-brand-600 transition-all hover:gap-2.5 dark:text-brand-400"
          >
            {t('services.cta')}
            <Icon name="arrowRight" class="h-4 w-4" />
          </a>
        </div>
      ))
    }
  </div>
</section>
