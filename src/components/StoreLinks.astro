---
import Icon from './Icon.astro';
import type { Lang, Project } from '../data/profile';
import { useTranslations } from '../i18n/ui';

interface Props {
  links: Project['links'];
  lang: Lang;
}

const { links, lang } = Astro.props;
const t = useTranslations(lang);

const items = [
  { href: links.appStore, icon: 'apple', label: t('projects.appStore') },
  { href: links.googlePlay, icon: 'play', label: t('projects.googlePlay') },
  { href: links.github, icon: 'github', label: t('projects.github') },
  { href: links.website, icon: 'external', label: t('projects.website') },
] as const;
---

<ul class="flex flex-wrap gap-2">
  {
    items
      .filter((item) => item.href)
      .map((item) => (
        <li>
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg bg-slate-900 px-3 py-2 text-xs font-semibold text-white transition hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
          >
            <Icon name={item.icon} class="h-4 w-4" />
            {item.label}
          </a>
        </li>
      ))
  }
</ul>
