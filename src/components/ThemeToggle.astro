---
import Icon from './Icon.astro';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class="grid h-10 w-10 place-items-center rounded-full text-slate-700 transition hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"
  aria-label={label}
  title={label}
>
  <Icon name="moon" class="h-5 w-5 dark:hidden" />
  <Icon name="sun" class="hidden h-5 w-5 dark:block" />
</button>

<script>
  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    });
  });
</script>
